[Unit]
Description=MOHHDY agent runtime HTTP (ASSIST-051)
Documentation=https://github.com/kamgueblondin/mohhdy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mohhdy
Group=mohhdy
WorkingDirectory=/opt/mohhdy-agent
Environment=MOHHDY_AGENT_HOST=0.0.0.0
Environment=MOHHDY_AGENT_PORT=8080
Environment=MOHHDY_AGENT_MODE=self_host
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/mohhdy-agent.env
ExecStart=/usr/bin/python3 /opt/mohhdy-agent/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
