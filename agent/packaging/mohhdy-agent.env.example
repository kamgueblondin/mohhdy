# Exemple d'environnement d'instance (ASSIST-051 / 053).
# Copier hors Git, par exemple vers /etc/mohhdy-agent.env.
# Ne jamais committer ADMIN_TOKEN ni une cle API.

MOHHDY_AGENT_HOST=0.0.0.0
MOHHDY_AGENT_PORT=8080
MOHHDY_AGENT_MODE=self_host
