# Image optionnelle "navigateur". PAS le chemin par defaut.
# make agent-smoke et le Dockerfile slim n'installent pas Chromium.
# Les gestes de cette tranche passent par le simulateur DOM in-process
# (voir docs/assist020_gestes_mcp.md). Playwright n'est PAS branche.
#
# Build (hors CI AOS, hors make integration-qemu) :
#   docker build -f Dockerfile.playwright -t mohhdy-agent-browser ./agent
#   docker compose --profile browser up --build
#
# Pour ajouter Chromium plus tard (gros, reseau, jamais dans la CI QEMU) :
#   pip install playwright && playwright install --with-deps chromium
# et poser MOHHDY_AGENT_HARNESS=playwright (reserve, non implemente).

FROM python:3.12-slim-bookworm

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin mohhdy

WORKDIR /app

COPY --chown=mohhdy:mohhdy *.py ./
COPY --chown=mohhdy:mohhdy config.example.json ./
COPY --chown=mohhdy:mohhdy static ./static

USER mohhdy

ENV MOHHDY_AGENT_HOST=0.0.0.0
ENV MOHHDY_AGENT_PORT=8080
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV MOHHDY_AGENT_HARNESS=dom_simulator

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health')"

CMD ["python3", "-u", "server.py"]
