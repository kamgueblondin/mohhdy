    /* lot 83: auto margins on a subgridded axis compute to zero */
    TEST_ASSERT_EQUAL(0, lot52_node("s")->y);
    TEST_ASSERT_EQUAL(20, lot52_node("s")->h);
    TEST_ASSERT_EQUAL(0, g_doc.ndiag);
}

